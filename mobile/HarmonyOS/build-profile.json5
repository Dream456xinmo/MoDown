{
  "app": {
    // 签名需要华为开发者账号下发的证书 + Profile（DevEco Studio → File → Project Structure → Signing Configs）。
    // 这里留空：hvigor 仍可产出**未签名** HAP（只能用于校验打包链路，装不到真机）。
    // 配好自动签名后，DevEco 会往这个数组里写一条 "name": "default"，并把 products[].signingConfig 指向它。
    "signingConfigs": [],
    "products": [
      {
        "name": "default",
        "compatibleSdkVersion": "5.0.0(12)",
        "runtimeOS": "HarmonyOS",
        "buildOption": {
          "strictMode": {
            "caseSensitiveCheck": true,
            "useNormalizedOHMUrl": true
          }
        }
      }
    ],
    "buildModeSet": [
      { "name": "debug" },
      { "name": "release" }
    ]
  },
  "modules": [
    {
      "name": "entry",
      "srcPath": "./entry",
      "targets": [
        {
          "name": "default",
          "applyToProducts": ["default"]
        }
      ]
    }
  ]
}
