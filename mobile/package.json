{
  "name": "modown-mobile",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "MoDown 移动端壳工程：Capacitor（Android）+ 鸿蒙 ArkWeb，复用 frontend 的 mobile 产物",
  "scripts": {
    "build:web": "cd ../frontend && npx vite build --mode mobile --outDir ../mobile/www --emptyOutDir",
    "sync": "npm run build:web && cap sync",
    "apk:debug": "npm run sync && cd Android && gradlew.bat assembleDebug",
    "apk:release": "npm run sync && cd Android && gradlew.bat assembleRelease",
    "apk": "powershell -NoProfile -ExecutionPolicy Bypass -File ./build-apk.ps1",
    "harmony:sync": "powershell -NoProfile -ExecutionPolicy Bypass -File ./build-hap.ps1 -SyncOnly",
    "harmony": "powershell -NoProfile -ExecutionPolicy Bypass -File ./build-hap.ps1"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "typescript": "~5.6.3"
  }
}
